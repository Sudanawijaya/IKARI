# Salin file ini menjadi .env di root proyek, lalu isi API key server.
# Jangan masukkan API key ke kode frontend atau commit file .env.
OPENAI_API_KEY=

# Nilai berikut mengikuti default backend api/ask.php.
# Sesuaikan dengan model yang tersedia pada akun Anda.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Opsional: untuk menyimpan .env di lokasi lain, atur OPENAI_ENV_FILE
# pada environment server/PHP sebelum aplikasi dijalankan.
# Contoh environment server: OPENAI_ENV_FILE=/path/private/ikari.env
# Jangan mengaturnya di sini karena path dibaca sebelum file .env dimuat.
